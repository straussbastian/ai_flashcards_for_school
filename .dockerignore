# Die Compose-Dateien gehoeren nicht ins Abbild - sie beschreiben, wie es
# gestartet wird, nicht was darin liegt.
compose.yml
compose.test.yml
# tests/ steht bewusst NICHT hier: Die Teststufe des Dockerfiles
# (target: test, siehe compose.test.yml) kopiert das Verzeichnis. Ins
# Betriebsabbild geraet es trotzdem nicht - die Stufe "betrieb" kopiert nur
# app, migrations, alembic.ini und docker.
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
