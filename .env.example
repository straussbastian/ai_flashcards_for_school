# Datenbank. Im Container zeigt die URL auf localhost im selben Container.
POSTGRES_PASSWORD=bitte-aendern
DATABASE_URL=postgresql+psycopg://flashcards:bitte-aendern@localhost:5432/flashcards

# Datenbank fuer die Testsuite. Wird nur beim Ausfuehren der Tests gebraucht,
# nie im Betrieb. Zeigt auf eine eigene Testdatenbank, damit die Tests nie die
# Entwicklungsdatenbank anfassen.
#
# Dieser Wert ist absichtlich KEIN Platzhalter, sondern genau der, den
# compose.dev.yml aufspannt (Port 55432, Passwort "entwicklung") und den auch
# .github/workflows/tests.yml benutzt. Nach dem Kopieren dieser Datei laufen
# die Tests damit ohne weitere Handgriffe. Das Passwort ist ein
# Entwicklungspasswort fuer eine Wegwerfdatenbank auf dem eigenen Rechner -
# kein Geheimnis.
TEST_DATABASE_URL=postgresql+psycopg://flashcards:entwicklung@localhost:55432/flashcards_test

# Signaturschluessel fuer OAuth-Tokens. Lang und zufaellig, z.B. `openssl rand -hex 32`.
APP_SECRET=bitte-aendern

# Das eine Passwort, mit dem sich die Lehrkraft beim Verbinden des Connectors anmeldet.
TEACHER_PASSWORD=bitte-aendern

# Oeffentliche Basis-URL ohne abschliessenden Schraegstrich. PFLICHT, ohne
# Default: Aus diesem Wert baut die Anwendung die Links zu den Lernseiten. Ein
# Default liesse sie im Betrieb klaglos starten und lauter unbrauchbare Links
# ausgeben. Muss mit http:// oder https:// beginnen, sonst startet sie nicht.
BASE_URL=https://karten.example.de

TZ=Europe/Berlin
