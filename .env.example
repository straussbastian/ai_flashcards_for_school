# Vorlage fuer die .env. Kopieren, Werte eintragen:
#
#     cp .env.example .env
#
# Die .env liegt nicht im Git. Sie versorgt beide Dienste aus compose.yml:
# den Dienst "db" (die POSTGRES_*-Werte) und den Dienst "app" (alles
# uebrige). Fuer den Betrieb auf Coolify werden dieselben Namen dort unter
# "Environment Variables" gesetzt.
#
# Fuer die Tests wird diese Datei NICHT gebraucht: compose.test.yml bringt
# ihre eigenen Wegwerfwerte mit (docker compose -f compose.test.yml up).

# ---- Die Datenbank (Dienst "db") ----------------------------------------
# Das offizielle postgres-Abbild legt Rolle und Datenbank beim Erststart aus
# genau diesen drei Werten an. Sie muessen zu DATABASE_URL weiter unten
# passen - sonst kommt die Anwendung nicht an ihre eigene Datenbank.
#
# ACHTUNG: Geaendert wird daraus nur beim ERSTSTART etwas. Ist das Volume
# "pgdata" schon angelegt, laesst ein spaeter geaendertes POSTGRES_PASSWORD
# die bestehende Rolle unberuehrt. Wer das Passwort im laufenden Betrieb
# wechseln will, muss es zusaetzlich in der Datenbank selbst aendern:
#
#     docker compose exec db psql -U flashcards -c \
#         "alter role flashcards password 'neues-passwort'"
POSTGRES_USER=flashcards
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=flashcards

# ---- Die Anwendung (Dienst "app") ---------------------------------------
# "db" ist der Dienstname aus compose.yml, nicht localhost: Anwendung und
# Datenbank sind zwei Container, und Docker loest den Dienstnamen im
# gemeinsamen Netz auf. Benutzer, Passwort und Datenbankname muessen den
# POSTGRES_*-Werten oben entsprechen.
DATABASE_URL=postgresql+psycopg://flashcards:bitte-aendern@db:5432/flashcards

# Signaturschluessel fuer OAuth-Tokens. Lang und zufaellig, z.B. `openssl rand -hex 32`.
APP_SECRET=bitte-aendern

# Das eine Passwort, mit dem sich die Lehrkraft beim Verbinden des Connectors anmeldet.
TEACHER_PASSWORD=bitte-aendern

# Oeffentliche Basis-URL ohne abschliessenden Schraegstrich. PFLICHT, ohne
# Default: Aus diesem Wert baut die Anwendung die Links zu den Lernseiten. Ein
# Default liesse sie im Betrieb klaglos starten und lauter unbrauchbare Links
# ausgeben. Muss mit http:// oder https:// beginnen, sonst startet sie nicht.
BASE_URL=https://karten.example.de

TZ=Europe/Berlin

# ---- Die Adresse, unter der der Container erreichbar ist -----------------
# APP_BIND=127.0.0.1 bedeutet: nur vom eigenen Rechner aus erreichbar, nie
# einfach so im umliegenden Netz. Wer den Server oeffentlich anbieten will,
# nimmt dafuer einen Tunnel (siehe docs/praxistest-cowork.md) oder das
# Deployment auf Coolify - und nicht 0.0.0.0 hier.
APP_BIND=127.0.0.1
APP_PORT=8000

# Der Port, unter dem die Datenbank vom Rechner aus erreichbar ist - fuer
# psql zur Fehlersuche und fuer ein "uvicorn --reload" auf dem Rechner
# (siehe README). Die Anwendung im Verbund benutzt ihn nicht; sie erreicht
# die Datenbank unter "db" im gemeinsamen Netz.
#
# 55432 und nicht 5432, damit ein etwaiges PostgreSQL auf dem Rechner selbst
# nicht in die Quere kommt. DB_BIND=127.0.0.1: nur vom Rechner selbst
# erreichbar, nie im umliegenden Netz.
DB_BIND=127.0.0.1
DB_PORT=55432
